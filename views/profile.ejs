<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
      integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/css/utilities.css" />
    <link rel="stylesheet" href="/css/nav.css" />
    <link rel="stylesheet" href="/css/profile.css" />

    <title>Shape||Build you community</title>
  </head>
  <body style="visibility: hidden">
    <!-- top navebar -->
    <section class="nave-bar">
      <div class="container sm flex">
        <a href="/home"
          ><img class="" src="/assets/shape.png" alt="" height="30px"
        /></a>

        <div class="search flex">
          <i class="fa fa-search"></i>
          <input type="text" name="search" placeholder="Search" />
        </div>

        <div class="action">
          <ul class="flex">
            <li>
              <a href="/compose"
                >Create <i class="fa fa-plus" aria-hidden="true"></i
              ></a>
            </li>
            <li>
              <a href=""><i class="fa fa-bell" aria-hidden="true"></i></a>
            </li>
          </ul>
        </div>

        <div class="profile">
          <img class="p-pic-nav" src="<%=currentUser.profile_pic_url%>" alt="" />
          <div class="profile-menu">
            <ul class="flex">
               <li><a href="/profile">Profile</a></li>
              <li><a href="/setting">Setting</a></li>
              <li><a href="/logout">Logout</a></li>
            </ul>
          </div>
        </div>
      </div>
      </div>
    </section>


    





    <!-- main -->
    <section class="main" data-id="<%=currentUser.id%>">
      <div class="main-navL">
        <button class="btn MnavL-btn">
          <i class="fa fa-bars fa-lg" aria-hidden="true "></i>
        </button>
        <div class="demo">
          <div class="demo-j flex">
            <a href="/home"
              ><i
                class="fa fa-home"
                aria-hidden="true"
                style="margin-right: 10px"
              ></i>
              Home</a
            >
            <a href=""
              ><i
                class="fa fa-line-chart"
                aria-hidden="true"
                style="margin-right: 10px"
              ></i>
              Popular</a
            >
            <a href=""
              ><i
                class="fa fa-users"
                aria-hidden="true"
                style="margin-right: 10px"
              ></i>
              Community</a
            >
            <a href=""
              ><i
                class="fa fa-search-plus"
                aria-hidden="true"
                style="margin-right: 10px"
              ></i>
              Explore</a
            >
          </div>
        </div>
      </div>
      <div class="container" style="padding-right: 15px">
       
        <div class="update"></div>
        <div class="post-wrapper" data-id="<%=profileUser.id%>" >
        <%if (profileUser.id===currentUser.id){%>
         <div class="profile-hero flex">
             <div class="profile-P flex">
              <div class="p-pic">
                 <img class="p-p" src="<%=profileUser.profile_pic_url%> " alt="">
              </div>
              <div class="p-name ml-s">
                <h3 style="font-size:1.5rem;"><%=profileUser.first_name%> <%=profileUser.last_name%></h3>
                <p class="mb-s"  style="font-size: small;font-style: italic;color: rgba(0, 0, 0, 0.475);">UniqueName</p>
                </div>
             </div>
             <div class="profile-nav flex">
                 <input type="radio" id="option1" name="nav_el"/>
                  <label for="option1"><a href="/profile/<%=profileUser.id%>">Post</a></label>
             
             
                  <input type="radio" id="option2" name="nav_el" />
                 <label for="option2">Comment</label>
             
             
                  <input type="radio" id="option3" name="nav_el" />
                 <label for="option3">Saved</label>
             
             
                 <input type="radio" id="option4" name="nav_el" />
                 <label for="option4">Like</label>
              </div>
            </div>
             <%}else{%> 
              <div class="profile-hero flex">
             <div class="profile-P flex">
              <div class="p-pic">
                 <img class="p-p" src="<%=profileUser.profile_pic_url%> " alt="">
              </div>
              <div class="p-name ml-s">
                <h3 style="font-size:1.5rem;"><%=profileUser.first_name%> <%=profileUser.last_name%></h3>
                <p class="mb-s"  style="font-size: small;font-style: italic;color: rgba(0, 0, 0, 0.475)">UniqueName</p>
                </div>
             </div>
             <div class="profile-nav flex">
             
             
              
             <input type="radio" id="option1" name="nav_el"/>
             <label for="option1"><a href="/profile/<%=profileUser.id%>">Post</a></label>
             
             <input type="radio" id="option2" name="nav_el" />
             <label for="option2">Comment</label>
               
              
                </div>
              </div>
              <%}%>
       <div id="content">     
       <%if(posts.length===0){%>
        <div class="post-cover text-center" style="border: none; margin-top: 3rem; font-size: larger; font-weight: 400;">
  <%=profileUser.first_name%> <%=profileUser.last_name%> haven't posted yet 🤓
</div>

        <%}else{%>
        
        <%if (profileUser.id===currentUser.id){%> <%posts.forEach((post,i)=>{%>
        <div class="post-cover" >
        <div id="p<%=post.id%>" class="post" data-id=<%=post.id%>>
          <div class="personal-p flex">
            <a href="/profile/<%=post.user_id%>"

              ><div class="profile-pic">
                <img class="p-p" src="<%=profileUser.profile_pic_url%>" alt="" />
              </div></a
            >

            <a href="/profile/<%=post.user_id%>"
              ><p style="font-size: medium">
                <%=currentUser.first_name%> <%=currentUser.last_name%>
              </p></a
            >
             <div class="p-opt flex" style="margin-left: auto">
              <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
              <div class="p-optD">
               <button
              class="update-btn p-opt-btn"
              data-id="<%=post.id%>"
              data-index="<%=i%>"
              
            >
              <i class="fa fas fa-pencil-alt" aria-hidden="true"></i> Edit post detail
            </button>
            <form
              action="/delete/<%=post.id%>"
              method="post"
              
            >
              <button  class="p-opt-btn" type="submit">
                <i class="fa fa-trash" aria-hidden="true"></i> Delete
              </button>
            </form>
             </div>
            </div>
           
          </div>

          <h4 class="post-title sm-x"><%=post.title%></h4>

          <% if (post.detail && post.detail.trim() !== "") { %>
          <p class="post-detail sm-x"><%=post.detail%></p>
          <% } %>

          <div class="function flex">
              <button class="like">
                <i class="fa fa-thumbs-up" aria-hidden="true"></i>
                <span class="like-t"><%=post.likes%></span>
              </button>
              <button class="dislike">
                <i class="fa fa-thumbs-down" aria-hidden="true"></i>
                <span class="dislike-t"><%=post.dislikes%></span>
              </button>
              <button>
                <i class="fa fa-comment" aria-hidden="true"></i> <span><%=post.comments%></span>
              </button>
            </div>
        </div>
        </div>
        <%})%> <%}else{%> <% posts.forEach((post)=>{ %>
          <div class="post-cover" >
        <div id="p<%=post.id%>" class="post" data-id=<%=post.id%>>
         

          <div class="personal-p flex">
            <a href="/profile/<%=post.user_id%>"
              ><div class="profile-pic">
                 <img class="p-p" src="<%=profileUser.profile_pic_url%>" alt="" />
              </div></a
            >

            <a href="/profile/<%=post.user_id%>"
              ><p style="font-size: medium">
                <%=profileUser.first_name%> <%=profileUser.last_name%>
              </p></a
            >
             <div class="p-opt flex" style="margin-left: auto">
              <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
              <div class="p-optD">
               <button
              class=" p-opt-btn save-btn"
              
              
            >
              <i class="fa fa-bookmark" aria-hidden="true"></i> Save
            </button>
            
             </div>
            </div>
           
          </div>

          <h4 class="post-title sm-x"><%=post.title%></h4>

          <% if (post.detail && post.detail.trim() !== "") { %>
          <p class="post-detail sm-x"><%=post.detail%></p>
          <% } %>

         <div class="function flex">
              <button class="like">
                <i class="fa fa-thumbs-up" aria-hidden="true"></i>
                <span class="like-t"><%=post.likes%></span>
              </button>
              <button class="dislike">
                <i class="fa fa-thumbs-down" aria-hidden="true"></i>
                <span class="dislike-t"><%=post.dislikes%></span>
              </button>
              <button>
                <i class="fa fa-comment" aria-hidden="true"></i> <span><%=post.comments%></span>
              </button>
            </div>
        </div>
        </div>
        <%})%> <%}%>
        <%}%>
        </div>  
        </div>
      </div>
      <div class="nav-r">
        <div class="main-navR">
          
        </div>
      </div>
    </section>
    <script>
      window.serverData = { posts: <%- JSON.stringify(posts) %> };
    </script>
    <script type="module" src="/js/profile.js"></script>
  </body>
</html>

